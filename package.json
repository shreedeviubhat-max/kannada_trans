{
  "name": "kali-kannada",
  "version": "1.0.0",
  "description": "ಕಲಿ ಕನ್ನಡ, ನಲಿ ಕನ್ನಡದಿ - An expert, friendly, and culturally grounded AI companion for Kannada learning, translation, and games",
  "main": "api/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client:dev\"",
    "server": "node api/index.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "start": "node api/index.js"
  },
  "keywords": [
    "kannada",
    "gemini",
    "translation",
    "kannada-learning",
    "ai",
    "multimodal",
    "vercel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
